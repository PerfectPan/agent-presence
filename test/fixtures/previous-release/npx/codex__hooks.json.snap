{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes --registry=https://registry.npmjs.org @rivus/agent-presence@0.9.0 hook --source codex --event SessionStart 2>/dev/null || echo '{}'",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes --registry=https://registry.npmjs.org @rivus/agent-presence@0.9.0 hook --source codex --event UserPromptSubmit 2>/dev/null || echo '{}'",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes --registry=https://registry.npmjs.org @rivus/agent-presence@0.9.0 hook --source codex --event PreToolUse 2>/dev/null || echo '{}'",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes --registry=https://registry.npmjs.org @rivus/agent-presence@0.9.0 hook --source codex --event Stop 2>/dev/null || echo '{}'",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}

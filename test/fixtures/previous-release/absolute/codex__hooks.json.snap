{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/node /work/checkout/dist/src/cli.js hook --source codex --event SessionStart 2>/dev/null || echo '{}'",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/node /work/checkout/dist/src/cli.js hook --source codex --event UserPromptSubmit 2>/dev/null || echo '{}'",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/node /work/checkout/dist/src/cli.js hook --source codex --event PreToolUse 2>/dev/null || echo '{}'",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/node /work/checkout/dist/src/cli.js hook --source codex --event Stop 2>/dev/null || echo '{}'",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}

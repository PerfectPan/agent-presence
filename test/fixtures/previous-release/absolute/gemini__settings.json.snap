{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/node /work/checkout/dist/src/cli.js hook --source gemini --event SessionStart --silent >/dev/null 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/node /work/checkout/dist/src/cli.js hook --source gemini --event UserPromptSubmit --silent >/dev/null 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/node /work/checkout/dist/src/cli.js hook --source gemini --event PreToolUse --silent >/dev/null 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/node /work/checkout/dist/src/cli.js hook --source gemini --event PostToolUse --silent >/dev/null 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/node /work/checkout/dist/src/cli.js hook --source gemini --event Stop --silent >/dev/null 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/node /work/checkout/dist/src/cli.js hook --source gemini --event SessionEnd --silent >/dev/null 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
